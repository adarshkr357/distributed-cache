# ──────────────────────────────────────────────
# Distributed Cache — Environment Configuration
# ──────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# DO NOT commit .env to version control.

# ── MySQL ──
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=distributed_cache
MYSQL_USER=cache_user
MYSQL_PASSWORD=change-me-user-password

# ── Management API ──
API_KEY=change-me-api-key

# ── Cache Nodes ──
MAX_CAPACITY=10000
CACHE_NODES=cache-node-1:6001,cache-node-2:6002,cache-node-3:6003
